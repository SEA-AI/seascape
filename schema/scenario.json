{
  "$defs": {
    "Band": {
      "enum": [
        "eo",
        "ir"
      ],
      "type": "string"
    },
    "Camera": {
      "additionalProperties": false,
      "description": "One camera in a pod: its band, its aim relative to the pod, its image.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/Band",
          "description": "The band it sees in: eo visible, ir LWIR."
        },
        "yaw_deg": {
          "default": 0.0,
          "description": "Relative to the pod axis, positive to starboard.",
          "title": "Yaw Deg",
          "type": "number"
        },
        "pitch_deg": {
          "default": 0.0,
          "description": "Relative to the pod, negative is down.",
          "exclusiveMaximum": 90.0,
          "exclusiveMinimum": -90.0,
          "title": "Pitch Deg",
          "type": "number"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its image's filename. Derived from its place in the pod when absent.",
          "title": "Name"
        },
        "hfov_deg": {
          "description": "Measured across the image width, even in portrait.",
          "exclusiveMaximum": 180.0,
          "exclusiveMinimum": 0.0,
          "title": "Hfov Deg",
          "type": "number"
        },
        "width_px": {
          "description": "Image width.",
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "description": "Image height.",
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "hfov_deg",
        "width_px",
        "height_px"
      ],
      "title": "Camera",
      "type": "object"
    },
    "Drift": {
      "additionalProperties": false,
      "description": "A hull at single anchor fishtails: across its heading once a period, along it\ntwice. Starts at its pose; the heading holds.",
      "properties": {
        "sway_m": {
          "description": "Peak, across the heading.",
          "minimum": 0.0,
          "title": "Sway M",
          "type": "number"
        },
        "surge_m": {
          "description": "Peak, along the heading.",
          "minimum": 0.0,
          "title": "Surge M",
          "type": "number"
        },
        "period_s": {
          "description": "One full figure-eight.",
          "exclusiveMinimum": 0.0,
          "title": "Period S",
          "type": "number"
        }
      },
      "required": [
        "sway_m",
        "surge_m",
        "period_s"
      ],
      "title": "Drift",
      "type": "object"
    },
    "Heave": {
      "additionalProperties": false,
      "description": "A sinusoid about the waterline, starting at it.",
      "properties": {
        "amplitude_m": {
          "description": "Peak, either way.",
          "minimum": 0.0,
          "title": "Amplitude M",
          "type": "number"
        },
        "period_s": {
          "description": "One full cycle.",
          "exclusiveMinimum": 0.0,
          "title": "Period S",
          "type": "number"
        }
      },
      "required": [
        "amplitude_m",
        "period_s"
      ],
      "title": "Heave",
      "type": "object"
    },
    "ImageFormat": {
      "enum": [
        "exr",
        "png",
        "jpg"
      ],
      "type": "string"
    },
    "Object": {
      "additionalProperties": false,
      "description": "Something to detect.",
      "properties": {
        "asset": {
          "description": "An asset name from the manifest.",
          "title": "Asset",
          "type": "string"
        },
        "range_m": {
          "description": "Horizontal, from the ownship's origin.",
          "exclusiveMinimum": 0.0,
          "title": "Range M",
          "type": "number"
        },
        "bearing_deg": {
          "description": "Clockwise from the ownship's bow.",
          "title": "Bearing Deg",
          "type": "number"
        },
        "heading_deg": {
          "default": 0.0,
          "description": "Where its bow points, clockwise from the ownship's bow.",
          "title": "Heading Deg",
          "type": "number"
        },
        "speed_mps": {
          "default": 0.0,
          "description": "Along its heading.",
          "minimum": 0.0,
          "title": "Speed Mps",
          "type": "number"
        },
        "drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/Drift"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A figure-eight about its pose."
        },
        "orbit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Orbit"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Round the ownship."
        },
        "t_k": {
          "default": 293.0,
          "description": "Shaded hull temperature. IR only.",
          "maximum": 400.0,
          "minimum": 250.0,
          "title": "T K",
          "type": "number"
        }
      },
      "required": [
        "asset",
        "range_m",
        "bearing_deg"
      ],
      "title": "Object",
      "type": "object"
    },
    "Orbit": {
      "additionalProperties": false,
      "description": "Round the ownship's origin clockwise from the hull's bearing, at its range, bow\nalong the circle.\n\nIdentical hulls share the lap evenly, so a loop need only last `period_s / count`.",
      "properties": {
        "period_s": {
          "description": "One full lap.",
          "exclusiveMinimum": 0.0,
          "title": "Period S",
          "type": "number"
        },
        "count": {
          "default": 1,
          "description": "Hulls spaced evenly on it.",
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "period_s"
      ],
      "title": "Orbit",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "description": "What a render writes.\n\nEvery camera of a listed band is rendered. An EO png or jpg is 8-bit, through the\nexposure and the film curve. An LWIR png is 16-bit, a hundredth of a kelvin per\ncount; an LWIR jpg is 8-bit grey, auto-contrasted as a thermal camera does. An exr\nkeeps the radiance, in W m^-2 sr^-1.",
      "properties": {
        "bands": {
          "default": [
            "eo",
            "ir"
          ],
          "description": "Bands to render; one with no camera is skipped.",
          "items": {
            "$ref": "#/$defs/Band"
          },
          "minItems": 1,
          "title": "Bands",
          "type": "array",
          "uniqueItems": true
        },
        "samples": {
          "$ref": "#/$defs/Samples"
        },
        "format": {
          "$ref": "#/$defs/ImageFormat",
          "default": "jpg",
          "description": "jpg to look at, png lossless or LWIR in kelvin, exr the radiance."
        },
        "exposure_ev": {
          "default": -5.0,
          "description": "Exposure in stops. Applies to 8-bit EO only.",
          "maximum": 32.0,
          "minimum": -32.0,
          "title": "Exposure Ev",
          "type": "number"
        },
        "duration_s": {
          "default": 0.0,
          "description": "0 is a still.",
          "minimum": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "fps": {
          "default": 10,
          "description": "Frames per second of a sequence.",
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "integer"
        },
        "loop": {
          "default": false,
          "description": "Repeats seamlessly: each period rounds to a whole fraction of duration_s.",
          "title": "Loop",
          "type": "boolean"
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "Ownship": {
      "additionalProperties": false,
      "description": "The vessel the rig is bolted to, rolling and pitching about its origin at the\nwaterline. Without an asset it is the attitude alone.",
      "properties": {
        "asset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An asset name from the manifest.",
          "title": "Asset"
        },
        "t_k": {
          "default": 296.0,
          "description": "Shaded hull temperature. IR only.",
          "maximum": 400.0,
          "minimum": 250.0,
          "title": "T K",
          "type": "number"
        },
        "roll_deg": {
          "default": 0.0,
          "description": "Positive is starboard down.",
          "exclusiveMaximum": 90.0,
          "exclusiveMinimum": -90.0,
          "title": "Roll Deg",
          "type": "number"
        },
        "pitch_deg": {
          "default": 0.0,
          "description": "Positive is bow up.",
          "exclusiveMaximum": 90.0,
          "exclusiveMinimum": -90.0,
          "title": "Pitch Deg",
          "type": "number"
        },
        "roll": {
          "anyOf": [
            {
              "$ref": "#/$defs/Swing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "About roll_deg."
        },
        "pitch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Swing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "About pitch_deg."
        },
        "heave": {
          "anyOf": [
            {
              "$ref": "#/$defs/Heave"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "About the waterline."
        }
      },
      "title": "Ownship",
      "type": "object"
    },
    "Pod": {
      "additionalProperties": false,
      "description": "One enclosure: several cameras behind one yaw and one mount point.\n\nPods a beam apart overlap in angle before they overlap in space, which leaves a\nblind wedge over the bow; coincident cameras would hide it.",
      "properties": {
        "name": {
          "description": "Prefixes the filenames of its unnamed cameras.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Name",
          "type": "string"
        },
        "yaw_deg": {
          "description": "Pod axis relative to the bow, positive to starboard.",
          "title": "Yaw Deg",
          "type": "number"
        },
        "offset_x_m": {
          "default": 0.0,
          "description": "From the centreline, positive to starboard.",
          "title": "Offset X M",
          "type": "number"
        },
        "offset_y_m": {
          "default": 0.0,
          "description": "From midships, positive forward.",
          "title": "Offset Y M",
          "type": "number"
        },
        "cameras": {
          "description": "The cameras in this pod.",
          "items": {
            "$ref": "#/$defs/Camera"
          },
          "minItems": 1,
          "title": "Cameras",
          "type": "array"
        }
      },
      "required": [
        "name",
        "yaw_deg",
        "cameras"
      ],
      "title": "Pod",
      "type": "object"
    },
    "Rig": {
      "additionalProperties": false,
      "description": "The pods on the ownship.",
      "properties": {
        "height_m": {
          "description": "Pod height above the waterline.",
          "exclusiveMinimum": 0.0,
          "title": "Height M",
          "type": "number"
        },
        "pitch_deg": {
          "default": 0.0,
          "description": "Every pod, about its own transverse axis. Negative is down.",
          "exclusiveMaximum": 90.0,
          "exclusiveMinimum": -90.0,
          "title": "Pitch Deg",
          "type": "number"
        },
        "near_clip_m": {
          "default": 5.0,
          "description": "Anything nearer a camera is not rendered.",
          "exclusiveMinimum": 0.0,
          "title": "Near Clip M",
          "type": "number"
        },
        "pods": {
          "description": "The camera enclosures on the ownship.",
          "items": {
            "$ref": "#/$defs/Pod"
          },
          "minItems": 1,
          "title": "Pods",
          "type": "array"
        }
      },
      "required": [
        "height_m",
        "pods"
      ],
      "title": "Rig",
      "type": "object"
    },
    "Samples": {
      "additionalProperties": false,
      "description": "Cycles samples per band.\n\nA model so an override merges field by field; a dict would replace it whole\nand drop the band left out.",
      "properties": {
        "eo": {
          "default": 16,
          "description": "Per pixel, for EO frames.",
          "exclusiveMinimum": 0,
          "title": "Eo",
          "type": "integer"
        },
        "ir": {
          "default": 64,
          "description": "Per pixel, for IR frames.",
          "exclusiveMinimum": 0,
          "title": "Ir",
          "type": "integer"
        }
      },
      "title": "Samples",
      "type": "object"
    },
    "Sea": {
      "additionalProperties": false,
      "description": "Sea state. Wind reaches the waves through wavelength and slope.\n\nThe temperature bound is the span of the shipped optical-constant table. `lwir`\nclamps to it; here it is an error.",
      "properties": {
        "t_sea_k": {
          "default": 288.0,
          "description": "Sea surface temperature. IR only.",
          "maximum": 311.0,
          "minimum": 271.0,
          "title": "T Sea K",
          "type": "number"
        },
        "wind_speed_mps": {
          "default": 7.0,
          "description": "Sets the waves' length and slope.",
          "minimum": 0.0,
          "title": "Wind Speed Mps",
          "type": "number"
        },
        "refraction_k": {
          "default": 0.13,
          "description": "Coefficient of terrestrial refraction; 0 is none.",
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Refraction K",
          "type": "number"
        }
      },
      "title": "Sea",
      "type": "object"
    },
    "Sky": {
      "additionalProperties": false,
      "description": "Blender's Sky Texture in EO, and the downwelling radiance the sea reflects in IR.\n\nHaze is `aerosol_density`, the node's own parameter.\n\n`t_air_k` scales the IR sky and nothing in EO. Its bound is where the fixed sky\nprofile stays credible.",
      "properties": {
        "sun_elevation_deg": {
          "default": 30.0,
          "description": "Above the horizon; negative is below it.",
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Sun Elevation Deg",
          "type": "number"
        },
        "sun_bearing_deg": {
          "default": 0.0,
          "description": "Clockwise from the ownship's bow.",
          "title": "Sun Bearing Deg",
          "type": "number"
        },
        "solar_gain_k": {
          "default": 8.5,
          "description": "How much warmer a sunlit surface is than a shaded one. IR only.",
          "minimum": 0.0,
          "title": "Solar Gain K",
          "type": "number"
        },
        "aerosol_density": {
          "default": 1.0,
          "description": "Haze, as the Sky Texture's own parameter. EO only.",
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Aerosol Density",
          "type": "number"
        },
        "t_air_k": {
          "default": 288.0,
          "description": "Scales the IR sky. EO ignores it.",
          "maximum": 320.0,
          "minimum": 250.0,
          "title": "T Air K",
          "type": "number"
        }
      },
      "title": "Sky",
      "type": "object"
    },
    "Swing": {
      "additionalProperties": false,
      "description": "A sinusoid about the mean attitude, starting at the mean.",
      "properties": {
        "amplitude_deg": {
          "description": "Peak, either way.",
          "exclusiveMaximum": 90.0,
          "minimum": 0.0,
          "title": "Amplitude Deg",
          "type": "number"
        },
        "period_s": {
          "description": "One full cycle.",
          "exclusiveMinimum": 0.0,
          "title": "Period S",
          "type": "number"
        }
      },
      "required": [
        "amplitude_deg",
        "period_s"
      ],
      "title": "Swing",
      "type": "object"
    },
    "Targets": {
      "additionalProperties": false,
      "description": "A ring of vessels at one range, spread over a span of bearings.\n\nPlaced in the world, so nothing guarantees a camera sees one.",
      "properties": {
        "asset": {
          "description": "An asset name from the manifest.",
          "title": "Asset",
          "type": "string"
        },
        "count": {
          "description": "How many.",
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "range_m": {
          "description": "Horizontal, from the ownship's origin.",
          "exclusiveMinimum": 0.0,
          "title": "Range M",
          "type": "number"
        },
        "bearing_deg": {
          "description": "First and last, clockwise from the ownship's bow. Both ends get a target.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bearing Deg",
          "type": "array"
        },
        "heading_deg": {
          "default": [
            0.0,
            315.0
          ],
          "description": "First and last, spread evenly, clockwise from the ownship's bow.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Heading Deg",
          "type": "array"
        },
        "speed_mps": {
          "default": 0.0,
          "description": "Along its heading.",
          "minimum": 0.0,
          "title": "Speed Mps",
          "type": "number"
        },
        "drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/Drift"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A figure-eight about its pose."
        },
        "t_k": {
          "default": 293.0,
          "description": "Shaded hull temperature. IR only.",
          "maximum": 400.0,
          "minimum": 250.0,
          "title": "T K",
          "type": "number"
        }
      },
      "required": [
        "asset",
        "count",
        "range_m",
        "bearing_deg"
      ],
      "title": "Targets",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One scene: the rig, the world around it, and what a render writes.",
  "properties": {
    "seed": {
      "default": 0,
      "description": "Seeds every random draw.",
      "title": "Seed",
      "type": "integer"
    },
    "rig": {
      "$ref": "#/$defs/Rig"
    },
    "ownship": {
      "$ref": "#/$defs/Ownship"
    },
    "targets": {
      "anyOf": [
        {
          "$ref": "#/$defs/Targets"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A ring of identical vessels."
    },
    "sea": {
      "$ref": "#/$defs/Sea"
    },
    "sky": {
      "$ref": "#/$defs/Sky"
    },
    "objects": {
      "description": "Vessels placed one by one.",
      "items": {
        "$ref": "#/$defs/Object"
      },
      "title": "Objects",
      "type": "array"
    },
    "outputs": {
      "$ref": "#/$defs/Outputs"
    }
  },
  "required": [
    "rig"
  ],
  "title": "Scenario",
  "type": "object"
}
