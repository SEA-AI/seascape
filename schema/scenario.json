{
  "$defs": {
    "Atmosphere": {
      "enum": [
        "tropical",
        "midlatitude_summer",
        "midlatitude_winter",
        "subarctic_summer",
        "subarctic_winter",
        "us_standard",
        "north_sea",
        "north_sea_winter",
        "north_sea_summer"
      ],
      "type": "string"
    },
    "Band": {
      "enum": [
        "eo",
        "ir"
      ],
      "type": "string"
    },
    "Camera": {
      "additionalProperties": false,
      "description": "One camera on a rig.",
      "properties": {
        "band": {
          "description": "The band it sees in: eo visible, ir LWIR.",
          "anyOf": [
            {
              "$ref": "#/$defs/Band"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "yaw_deg": {
          "title": "Yaw Deg",
          "description": "Relative to the rig's axis, positive to starboard.",
          "default": 0.0,
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "pitch_deg": {
          "title": "Pitch Deg",
          "description": "Relative to the rig, negative is down.",
          "default": 0.0,
          "anyOf": [
            {
              "exclusiveMaximum": 90.0,
              "exclusiveMinimum": -90.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "hfov_deg": {
          "title": "Hfov Deg",
          "description": "Measured across the image width, even in portrait.",
          "anyOf": [
            {
              "exclusiveMaximum": 180.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "width_px": {
          "title": "Width Px",
          "description": "Image width.",
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "height_px": {
          "title": "Height Px",
          "description": "Image height.",
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "required": [
        "band",
        "hfov_deg",
        "width_px",
        "height_px"
      ],
      "title": "Camera",
      "type": "object"
    },
    "Drift": {
      "additionalProperties": false,
      "description": "A hull at single anchor fishtails: across its heading once a period, along it\ntwice. Starts at its pose; the heading holds.",
      "properties": {
        "sway_m": {
          "title": "Sway M",
          "description": "Peak, across the heading.",
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "surge_m": {
          "title": "Surge M",
          "description": "Peak, along the heading.",
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "period_s": {
          "title": "Period S",
          "description": "One full figure-eight.",
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "required": [
        "sway_m",
        "surge_m",
        "period_s"
      ],
      "title": "Drift",
      "type": "object"
    },
    "Heave": {
      "additionalProperties": false,
      "description": "A sinusoid about the waterline, starting at it.",
      "properties": {
        "amplitude_m": {
          "title": "Amplitude M",
          "description": "Peak, either way.",
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "period_s": {
          "title": "Period S",
          "description": "One full cycle.",
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "required": [
        "amplitude_m",
        "period_s"
      ],
      "title": "Heave",
      "type": "object"
    },
    "ImageFormat": {
      "enum": [
        "exr",
        "png",
        "jpg"
      ],
      "type": "string"
    },
    "Name": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Object": {
      "additionalProperties": false,
      "description": "Something to detect.",
      "properties": {
        "asset": {
          "title": "Asset",
          "description": "An asset name from the manifest: `seascape assets list` shows them.",
          "anyOf": [
            {
              "enum": [
                "bulk_carrier",
                "cargo_ship",
                "container",
                "container_ship",
                "lateral_mark",
                "log",
                "mooring_buoy",
                "ocean_buoy",
                "pallet",
                "patrol_vessel",
                "pillar_buoy",
                "sea_mine",
                "small_container_ship",
                "yacht"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "range_m": {
          "title": "Range M",
          "description": "Horizontal, from the ownship's origin.",
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "bearing_deg": {
          "title": "Bearing Deg",
          "description": "Clockwise from the ownship's bow.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "heading_deg": {
          "title": "Heading Deg",
          "description": "Where its bow points, clockwise from the ownship's bow.",
          "default": 0.0,
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "speed_mps": {
          "title": "Speed Mps",
          "description": "Along its heading.",
          "default": 0.0,
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "drift": {
          "description": "A figure-eight about its pose.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Drift"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "orbit": {
          "description": "Round the ownship.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Orbit"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "t_k": {
          "title": "T K",
          "description": "Shaded hull temperature. IR only.",
          "default": 293.0,
          "anyOf": [
            {
              "maximum": 400.0,
              "minimum": 250.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "required": [
        "asset",
        "range_m",
        "bearing_deg"
      ],
      "title": "Object",
      "type": "object"
    },
    "Orbit": {
      "additionalProperties": false,
      "description": "Round the ownship's origin clockwise from the hull's bearing, at its range, bow\nalong the circle.\n\nIdentical hulls share the lap evenly, so a loop need only last `period_s / count`.",
      "properties": {
        "period_s": {
          "title": "Period S",
          "description": "One full lap.",
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "count": {
          "title": "Count",
          "description": "Hulls spaced evenly on it.",
          "default": 1,
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "required": [
        "period_s"
      ],
      "title": "Orbit",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "description": "What a render writes.\n\nEvery camera of a listed band is rendered. An EO png or jpg is 8-bit, as a camera\nwith auto-exposure takes it. An LWIR png is 16-bit, a hundredth of a kelvin per\ncount; an LWIR jpg is 8-bit grey, auto-contrasted as a thermal camera does. An exr\nkeeps the radiance, in W m^-2 sr^-1.",
      "properties": {
        "bands": {
          "title": "Bands",
          "description": "Bands to render; one with no camera is skipped.",
          "default": [
            "eo",
            "ir"
          ],
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Band"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "samples": {
          "anyOf": [
            {
              "$ref": "#/$defs/Samples"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "format": {
          "description": "jpg to look at, png lossless or LWIR in kelvin, exr the radiance.",
          "default": "jpg",
          "anyOf": [
            {
              "$ref": "#/$defs/ImageFormat"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "exposure_compensation_ev": {
          "title": "Exposure Compensation Ev",
          "description": "Stops over auto-exposure. Applies to 8-bit EO only.",
          "default": 0.0,
          "anyOf": [
            {
              "maximum": 126.0,
              "minimum": -126.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "duration_s": {
          "title": "Duration S",
          "description": "0 is a still.",
          "default": 0.0,
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "fps": {
          "title": "Fps",
          "description": "Frames per second of a sequence.",
          "default": 10,
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "loop": {
          "title": "Loop",
          "description": "Repeats seamlessly: each period rounds to a whole fraction of duration_s.",
          "default": false,
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "Ownship": {
      "additionalProperties": false,
      "description": "The vessel the rig is bolted to, rolling and pitching about its origin at the\nwaterline. Without an asset it is the attitude alone.",
      "properties": {
        "asset": {
          "title": "Asset",
          "description": "An asset name from the manifest: `seascape assets list` shows them.",
          "default": null,
          "anyOf": [
            {
              "enum": [
                "bulk_carrier",
                "cargo_ship",
                "container",
                "container_ship",
                "lateral_mark",
                "log",
                "mooring_buoy",
                "ocean_buoy",
                "pallet",
                "patrol_vessel",
                "pillar_buoy",
                "sea_mine",
                "small_container_ship",
                "yacht"
              ],
              "type": "string"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "t_k": {
          "title": "T K",
          "description": "Shaded hull temperature. IR only.",
          "default": 296.0,
          "anyOf": [
            {
              "maximum": 400.0,
              "minimum": 250.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "roll_deg": {
          "title": "Roll Deg",
          "description": "Positive is starboard down.",
          "default": 0.0,
          "anyOf": [
            {
              "exclusiveMaximum": 90.0,
              "exclusiveMinimum": -90.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "pitch_deg": {
          "title": "Pitch Deg",
          "description": "Positive is bow up.",
          "default": 0.0,
          "anyOf": [
            {
              "exclusiveMaximum": 90.0,
              "exclusiveMinimum": -90.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "roll": {
          "description": "About roll_deg.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Swing"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "pitch": {
          "description": "About pitch_deg.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Swing"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "heave": {
          "description": "About the waterline.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Heave"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "title": "Ownship",
      "type": "object"
    },
    "Rig": {
      "additionalProperties": false,
      "description": "One installed product: the frame its cameras sit in, at one mount point.\n\nRigs a beam apart overlap in angle before they overlap in space, which leaves a\nblind wedge over the bow; coincident cameras would hide it.",
      "properties": {
        "model": {
          "title": "Model",
          "description": "The product, such as Pod. A recording needs it.",
          "default": null,
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "height_m": {
          "title": "Height M",
          "description": "Above the waterline.",
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "yaw_deg": {
          "title": "Yaw Deg",
          "description": "Its axis relative to the bow, positive to starboard.",
          "default": 0.0,
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "pitch_deg": {
          "title": "Pitch Deg",
          "description": "About its own transverse axis, after its yaw and before its cameras'. Negative is down.",
          "default": 0.0,
          "anyOf": [
            {
              "exclusiveMaximum": 90.0,
              "exclusiveMinimum": -90.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "offset_x_m": {
          "title": "Offset X M",
          "description": "From the centreline, positive to starboard.",
          "default": 0.0,
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "offset_y_m": {
          "title": "Offset Y M",
          "description": "From midships, positive forward.",
          "default": 0.0,
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "near_clip_m": {
          "title": "Near Clip M",
          "description": "Anything nearer a camera is not rendered.",
          "default": 5.0,
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "cameras": {
          "title": "Cameras",
          "description": "Its cameras, by name.",
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/Camera"
              },
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/Name"
              },
              "type": "object"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "required": [
        "height_m",
        "cameras"
      ],
      "title": "Rig",
      "type": "object"
    },
    "Samples": {
      "additionalProperties": false,
      "description": "Cycles samples per band.\n\nA model so an override merges field by field; a dict would replace it whole\nand drop the band left out.",
      "properties": {
        "eo": {
          "title": "Eo",
          "description": "Per pixel, for EO frames.",
          "default": 16,
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "ir": {
          "title": "Ir",
          "description": "Per pixel, for IR frames.",
          "default": 64,
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        }
      },
      "title": "Samples",
      "type": "object"
    },
    "Sea": {
      "additionalProperties": false,
      "description": "The temperature bound is the span of the shipped optical-constant table. `lwir`\nclamps to it; here it is an error.",
      "properties": {
        "t_sea_k": {
          "title": "T Sea K",
          "description": "Sea surface temperature. IR only. Unset, the atmosphere's own.",
          "default": 283.88,
          "anyOf": [
            {
              "maximum": 311.0,
              "minimum": 271.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "wind_speed_mps": {
          "title": "Wind Speed Mps",
          "description": "Measured 10 m above the sea. Sets the wind sea.",
          "default": 7.0,
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "wind_from_deg": {
          "title": "Wind From Deg",
          "description": "Where the wind blows from, clockwise from the ownship's bow.",
          "default": 0.0,
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "swell": {
          "description": "On top of the wind's sea.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Swell"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
            }
          ]
        },
        "slick_cover": {
          "title": "Slick Cover",
          "description": "Fraction of the sea under slicks, gathered in windrows. None in calm air, where slick and clean water are one.",
          "default": 0.0,
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Choice"
